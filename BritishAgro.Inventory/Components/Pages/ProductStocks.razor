@page "/stocks"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@inject BritishAgro.Inventory.Services.Inventory.IInventoryTransactionService InventoryTransactionService
@inject BritishAgro.Inventory.Services.Inventory.IProductService ProductService
@inject BritishAgro.Inventory.Services.Time.BrowserTimeService BrowserTimeService
@inject BritishAgro.Inventory.Services.Notifications.NotificationService NotificationService

<PageTitle>Product Stock</PageTitle>

<SectionHeader Title="Product Stock" Subtitle="Add stock lots and review current batches in FIFO order." />

<div class="row g-4">
    <div class="col-lg-4">
        <div class="content-card">
            <h5 class="card-title mb-4">Add stock</h5>
            <EditForm Model="model" OnValidSubmit="SaveAsync" FormName="product-stock-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger mb-3" />
                <div class="mb-3">
                    <label class="form-label">Product</label>
                    <InputSelect class="form-select" @bind-Value="model.ProductId">
                        <option value="0">Select product</option>
                        @foreach (var product in products)
                        {
                            <option value="@product.ItemId">@product.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => model.ProductId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Quantity available</label>
                    <InputNumber class="form-control" @bind-Value="model.QuantityAvailable" />
                    <ValidationMessage For="() => model.QuantityAvailable" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Arrival date and time</label>
                    <InputDate class="form-control" @bind-Value="model.ArrivalDate" Type="InputDateType.DateTimeLocal" />
                    <ValidationMessage For="() => model.ArrivalDate" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-plus-circle me-2"></i>Add stock
                </button>
            </EditForm>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="content-card">
            <div class="row mb-4 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-start-0" placeholder="Search by product or category name..." 
                               @bind="searchQuery" @bind:event="oninput" @onkeyup="OnSearchChanged" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-secondary">Total: @allLots.Count stock lots</small>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="text-secondary mt-2">Loading stock lots...</p>
                </div>
            }
            else if (paginatedLots.Count == 0)
            {
                <EmptyState Title="No stock lots found" Message="@(string.IsNullOrEmpty(searchQuery) ? "Add a stock entry to begin tracking availability." : "No stock lots match your search criteria.")" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-4">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-end">Quantity</th>
                                <th>Addition Type</th>
                                <th>Arrival date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lot in paginatedLots)
                            {
                                <tr>
                                    <td>
                                        <strong>@lot.Product.Name</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@(lot.Product.Category?.Name ?? "Unassigned")</span>
                                    </td>
                                    <td class="text-end">
                                        <strong>@lot.QuantityAvailable.ToString("0.##")</strong>
                                    </td>
                                    <td>
                                        <span class="badge @(lot.AdditionType == "Return" ? "bg-info" : "bg-success")">@lot.AdditionType</span>
                                    </td>
                                    <td>
                                        <small class="text-secondary">@BrowserTimeService.Format(lot.ArrivalDate)</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <PaginationControls 
                    Items="paginatedLots" 
                    CurrentPage="currentPage" 
                    PageSize="pageSize" 
                    TotalItems="filteredLots.Count" 
                    OnPageChanged="OnPageChanged" />
            }
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<BritishAgro.Inventory.Data.StoreProductLot> allLots = [];
    private IReadOnlyList<BritishAgro.Inventory.Data.StoreProductLot> filteredLots = [];
    private IReadOnlyList<BritishAgro.Inventory.Data.StoreProductLot> paginatedLots = [];
    private IReadOnlyList<BritishAgro.Inventory.Data.Product> products = [];
    private StockInput model = new();
    private bool isLoading = true;
    private int currentPage = 1;
    private int pageSize = 10;
    private string searchQuery = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BrowserTimeService.EnsureInitializedAsync();
            if (model.ArrivalDate == default)
            {
                model.ArrivalDate = DateTime.Now;
                StateHasChanged();
            }
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            isLoading = true;
            products = await ProductService.GetAllAsync();
            allLots = await InventoryTransactionService.GetStockLotsAsync();
            filteredLots = allLots;
            UpdatePaginatedLots();
        }
        catch (Exception exception)
        {
            NotificationService.Error(exception.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchChanged()
    {
        currentPage = 1;
        ApplySearch();
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredLots = allLots;
        }
        else
        {
            var query = searchQuery.ToLower();
            filteredLots = allLots
                .Where(l => l.Product.Name.ToLower().Contains(query) || 
                           (l.Product.Category?.Name ?? string.Empty).ToLower().Contains(query))
                .ToList();
        }
        UpdatePaginatedLots();
    }

    private void UpdatePaginatedLots()
    {
        var startIndex = (currentPage - 1) * pageSize;
        paginatedLots = filteredLots.Skip(startIndex).Take(pageSize).ToList();
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        UpdatePaginatedLots();
    }

    private async Task SaveAsync()
    {
        try
        {
            await BrowserTimeService.EnsureInitializedAsync();
            await InventoryTransactionService.AddStockAsync(new BritishAgro.Inventory.Data.StoreProductLot
            {
                ProductId = model.ProductId,
                QuantityAvailable = model.QuantityAvailable,
                ArrivalDate = BrowserTimeService.ToUtcUnixMilliseconds(model.ArrivalDate)
            });

            NotificationService.Success("Stock added successfully.");
            model = new StockInput { ArrivalDate = DateTime.Now };
            await LoadAsync();
        }
        catch (Exception exception)
        {
            NotificationService.Error(exception.Message);
        }
    }

    private sealed class StockInput
    {
        [Range(1, int.MaxValue)]
        public int ProductId { get; set; }

        [Range(typeof(decimal), "0.01", "999999999")]
        public decimal QuantityAvailable { get; set; }

        public DateTime ArrivalDate { get; set; } = DateTime.Now;
    }
}
