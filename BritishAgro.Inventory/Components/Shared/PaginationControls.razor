@typeparam TItem

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="text-secondary mb-0">
            Showing <strong>@((CurrentPage - 1) * PageSize + (Items.Count > 0 ? 1 : 0))</strong> to 
            <strong>@((CurrentPage - 1) * PageSize + Items.Count)</strong> of <strong>@TotalItems</strong> items
        </p>
    </div>
    @if (TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination mb-0">
                <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(1)" disabled="@(CurrentPage <= 1)">First</button>
                </li>
                <li class="page-item @(CurrentPage <= 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage - 1)" disabled="@(CurrentPage <= 1)">Previous</button>
                </li>

                @for (int i = Math.Max(1, CurrentPage - 2); i <= Math.Min(TotalPages, CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == CurrentPage ? "active" : "")">
                        <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(i)">@i</button>
                    </li>
                }

                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(CurrentPage + 1)" disabled="@(CurrentPage >= TotalPages)">Next</button>
                </li>
                <li class="page-item @(CurrentPage >= TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => OnPageChanged.InvokeAsync(TotalPages)" disabled="@(CurrentPage >= TotalPages)">Last</button>
                </li>
            </ul>
        </nav>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter, EditorRequired]
    public int CurrentPage { get; set; }

    [Parameter, EditorRequired]
    public int PageSize { get; set; }

    [Parameter, EditorRequired]
    public int TotalItems { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<int> OnPageChanged { get; set; }

    private int TotalPages => (TotalItems + PageSize - 1) / PageSize;
}
